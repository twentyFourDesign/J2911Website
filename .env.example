# Contact form SMTP settings. Set these in Vercel → Settings → Environment Variables.
# They are read by the serverless function in api/contact.js and never sent to the browser.
SMTP_HOST=mail.24group.com.ng
SMTP_PORT=465
SMTP_USER=info@24group.com.ng
SMTP_PASS=
# Optional: where enquiries go (comma-separated). Defaults to SMTP_USER.
CONTACT_TO=
# Optional: sender address. Must be the SMTP mailbox or an alias of it. Defaults to SMTP_USER.
CONTACT_FROM=
